# Teşvikiye — teshvikiye.com (Apache / cPanel)
# Güvenlik sertleştirmesi: HTTPS zorunlu, sıkı güvenlik başlıkları, hassas dosyalara erişim yok, dizin listesi yok.
Options -Indexes -MultiViews
ServerSignature Off

# ---- Hassas dosyalar: web'den asla servis edilmez ----
<FilesMatch "^(\.htaccess|\.htpasswd|\.env.*|\.user\.ini|php\.ini|\.git.*|.*\.(bak|sql|log|sh|md|lock|map|yml|yaml|json))$">
  Require all denied
</FilesMatch>
<FilesMatch "^(index\.html|favicon\.svg|favicon-32\.png|icon-192\.png|apple-touch-icon\.png|robots\.txt|site\.webmanifest)$">
  Require all granted
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # TRACE/TRACK kapalı
  RewriteCond %{REQUEST_METHOD} ^(TRACE|TRACK)
  RewriteRule .* - [F]
  # Node.js API (Passenger) — hiçbir SPA kuralı uygulanmaz
  RewriteRule ^api(/.*)?$ - [L]
  # Gizli dizinler (nokta ile başlayan) — ACME doğrulaması hariç
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule (^|/)\.[^/]+ - [F]
  # HTTP → HTTPS (Let's Encrypt sertifikası cPanel AutoSSL ile yönetilir)
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # www → apex: tek kanonik köken (API Origin kontrolü ve çerezler tek alan adında kalsın)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
  # Site haritası ve Google Merchant akışı diskte yok; Node API üretir (bkz. api/src/routes/seo.js)
  RewriteRule ^sitemap\.xml$ /api/sitemap.xml [PT,L]
  RewriteRule ^feeds/google-merchant\.xml$ /api/feeds/google-merchant.xml [PT,L]
  # Sosyal/arama botları JS çalıştırmaz: sayfa metası sunucuda basılmış index.html'i alırlar
  # (GET /api/seo/render?path=/…; sorgu dizesi atılır). Dosya/varlık istekleri ve /api hariç.
  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|WhatsApp|Twitterbot|LinkedInBot|TelegramBot|Slackbot|Discordbot|Pinterest|Applebot|Googlebot|bingbot|YandexBot|DuckDuckBot|Baiduspider) [NC]
  RewriteCond %{REQUEST_URI} !^/(api|assets|fonts|logos|uploads|\.well-known)/
  RewriteCond %{REQUEST_URI} !\.(js|css|png|jpe?g|webp|avif|svg|ico|woff2?|xml|txt|mp4|webm)$
  RewriteRule ^(.*)$ /api/seo/render?path=/$1 [PT,L]
  # Gerçek dosya ve dizinlere dokunma
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  # Diğer her yol tek sayfa uygulamaya (index.html)
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always unset X-Powered-By
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  # İçerik Güvenlik Politikası: yalnızca kendi kaynaklarımız; satır içi script yok.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
  # Hash'li derleme varlıkları uzun süre önbelleklenir; index.html hep taze
  <FilesMatch "\.(js|css|woff2?|jpe?g|png|webp|avif|svg|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# BEGIN cPanel-generated php ini directives, do not edit
# Manual editing of this file may result in unexpected behavior.
# To make changes to this file, use the cPanel MultiPHP INI Editor (Home >> Software >> MultiPHP INI Editor)
# For more information, read our documentation (https://go.cpanel.net/EA4ModifyINI)
<IfModule php8_module>
   php_value error_log "/home/teshvikiyeadmin/logs/php.error.log"
   php_flag log_errors On
</IfModule>
<IfModule lsapi_module>
   php_value error_log "/home/teshvikiyeadmin/logs/php.error.log"
   php_flag log_errors On
</IfModule>
# END cPanel-generated php ini directives, do not edit

# php -- BEGIN cPanel-generated handler, do not edit
# “ea-php81” paketini varsayılan “PHP” programlama dili olarak ayarlayın.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php81 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
