# Teşvikiye API — ortam değişkenleri örneği.
# Sunucuda gerçek değerlerle ~/api/.env olarak kaydedilir (bu dosya yalnızca örnektir, gizli değer içermez).

NODE_ENV=production
PORT=3000

# MySQL bağlantısı
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Oturum (JWT) imzalama anahtarı — en az 32 karakter, rastgele ve gizli tutulmalı
SESSION_SECRET=

# İlk yönetici hesabı (scripts/seed.js bu bilgilerle owner hesabı oluşturur)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Yüklenen medya dosyalarının diskteki hedef klasörü ve genel URL öneki
UPLOAD_DIR=/home/teshvikiyeadmin/public_html/uploads
UPLOAD_PUBLIC_BASE=/uploads

# Tarayıcıdan gelen isteklerde izin verilen kaynak (CORS + CSRF Origin kontrolü)
CORS_ORIGIN=https://teshvikiye.com
