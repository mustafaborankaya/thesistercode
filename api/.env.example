# Teşvikiye API — ortam değişkenleri örneği.
# Sunucuda gerçek değerlerle ~/api/.env olarak kaydedilir (bu dosya yalnızca örnektir, gizli değer içermez).

NODE_ENV=production
PORT=3000

# MySQL bağlantısı
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Oturum (JWT) imzalama anahtarı — en az 32 karakter, rastgele ve gizli tutulmalı
SESSION_SECRET=

# İlk yönetici hesabı (scripts/seed.js bu bilgilerle owner hesabı oluşturur)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Yüklenen medya dosyalarının diskteki hedef klasörü ve genel URL öneki
UPLOAD_DIR=/home/teshvikiyeadmin/public_html/uploads
UPLOAD_PUBLIC_BASE=/uploads

# Tarayıcıdan gelen isteklerde izin verilen kaynak (CORS + CSRF Origin kontrolü).
# Birden fazla origin'e izin vermek için virgülle ayırın (ör. apex + www).
CORS_ORIGIN=https://teshvikiye.com,https://www.teshvikiye.com

# --- E-posta (isteğe bağlı; varsayılan: none → gönderim yok, yalnızca mail_log kaydı) ---
# E-postalardaki bağlantıların kökü (şifre sıfırlama, e-posta doğrulama); yoksa ilk CORS_ORIGIN kullanılır
# SITE_URL=https://teshvikiye.com
# MAIL_PROVIDER=none | log | smtp
MAIL_PROVIDER=none
# smtp için (cPanel e-posta hesabı örneği):
# SMTP_HOST=mail.teshvikiye.com
# SMTP_PORT=465
# SMTP_SECURE=1
# SMTP_USER=bilgi@teshvikiye.com
# SMTP_PASS=
# MAIL_FROM="Teshvikiye <bilgi@teshvikiye.com>"
# ADMIN_NOTIFY_EMAIL=

# --- Çevrim içi ödeme (iyzico Ödeme Formu) — bkz. README "## Ödeme (iyzico)" ---
# none   → çevrim içi ödeme yok; sipariş eskisi gibi 'new' oluşur, tahsilat yapılmaz (varsayılan)
# iyzico → sipariş 'pending_payment' oluşur, müşteri iyzico güvenli ödeme sayfasına yönlendirilir
# fake   → YALNIZCA yerel uçtan uca test (NODE_ENV=production iken uygulama açılmaz)
PAYMENT_PROVIDER=none
# iyzico panelinden (Ayarlar → Firma Ayarları): sandbox için sandbox-merchant.iyzipay.com, canlı için merchant.iyzipay.com.
# Gizlidir: yalnızca bu dosyada tutulur, koda/loglara/git'e girmez. PAYMENT_PROVIDER=iyzico iken ZORUNLU.
# IYZICO_API_KEY=
# IYZICO_SECRET_KEY=
# Sandbox (varsayılan): https://sandbox-api.iyzipay.com — Canlı: https://api.iyzipay.com
# IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
# Ödeme sayfasında açılacak taksit seçenekleri (1,2,3,6,9,12). Panel ayarı payment.installments doluysa o geçerlidir.
# PAYMENT_INSTALLMENTS=1,2,3,6,9
# ÖNEMLİ: iyzico ödeme sonucu ${SITE_URL}/api/payments/iyzico/callback adresine döner — SITE_URL canlı alan adı olmalı.
