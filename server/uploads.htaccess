# public_html/uploads — yalnızca statik görsel/video servis edilir; hiçbir script çalıştırılmaz.
Options -Indexes -ExecCGI -MultiViews
<IfModule mod_php8.c>
  php_flag engine off
</IfModule>
RemoveHandler .php .phtml .php8 .phar .pl .py .cgi .sh
RemoveType .php .phtml .php8 .phar .pl .py .cgi .sh
<FilesMatch "\.(php|phtml|php\d|phar|pl|py|cgi|sh|htaccess|htm|html|js|svgz)$">
  Require all denied
</FilesMatch>
<FilesMatch "\.(jpe?g|png|webp|avif|gif|svg|mp4|webm)$">
  Require all granted
  <IfModule mod_headers.c>
    Header set Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; sandbox"
    Header set X-Content-Type-Options "nosniff"
    Header set Cache-Control "public, max-age=2592000"
  </IfModule>
</FilesMatch>
